# Frontend-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Frontend readiness flags. Keep false until independently verified.
VITE_STRIPE_LIVE_VERIFIED=false
VITE_E2E_VERIFIED=false
VITE_PRODUCTION_READINESS_APPROVED=false
# Set true only after both site-chat Edge Functions, secrets, allowed-origin
# checks and Tenant A/Tenant B isolation tests have passed.
VITE_SITE_CHAT_RUNTIME_VERIFIED=false

# Server-only values below belong in Supabase Edge Function secrets.
# Never expose them with a VITE_ prefix and never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=
PUBLIC_APP_URL=
ALLOWED_ORIGINS=

# Webhook, billing and bootstrap verification
BOOTSTRAP_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_USAGE_REPORTING_ENABLED=false
STRIPE_VOICE_METER_EVENT_NAME=
STRIPE_WHATSAPP_METER_EVENT_NAME=
TWILIO_AUTH_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Provider credentials and API versions
TWILIO_ACCOUNT_SID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_GRAPH_API_VERSION=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ELEVENLABS_API_KEY=
TTS_PREVIEW_ENABLED=false
LOVABLE_API_KEY=

# OpenAI and secure public site chatbot
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
# Optional cost rates used only for internal estimates, not customer billing.
OPENAI_INPUT_EUR_PER_MILLION=0
OPENAI_OUTPUT_EUR_PER_MILLION=0
# Generate two independent high-entropy values. Rotation revokes active sessions.
CHATBOT_SESSION_SECRET=
CHATBOT_IP_HASH_SALT=

# Transactional email
RESEND_API_KEY=
RESEND_FROM=
